{
  "name": "ai-customer-service-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "typecheck": "tsc --noEmit",
    "test:health": "tsx tests/health.check.ts",
    "test:db": "tsx --env-file=.env tests/db.check.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
