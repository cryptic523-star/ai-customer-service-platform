# Copy this file to ".env" and replace every REPLACE_ME value.
# NEVER commit the real .env file.

# "local" turns on development-only features (detailed health info,
# internal testing API). If this is missing or anything else, the app
# behaves as PRODUCTION. Never set this to "local" on Netlify.
APP_ENV=local

# From Supabase: Project Settings > API (added in Stage 2)
SUPABASE_URL=REPLACE_ME_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_supabase_service_role_key

# From platform.openai.com > API keys (added in Stage 4)
OPENAI_API_KEY=REPLACE_ME_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# LOCAL DEVELOPMENT AND INTERNAL TESTING ONLY.
# A long random secret YOU invent. It unlocks the internal test API.
# Do NOT set this variable in Netlify production.
PLATFORM_API_KEY=REPLACE_ME_long_random_string
